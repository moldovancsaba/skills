{
  "schemaVersion": 1,
  "propertyDefinitions": [
    { "key": "id", "valueType": "string", "description": "Stable internal identifier." },
    { "key": "publicId", "valueType": "number", "description": "Human-facing numeric identifier when available." },
    { "key": "companyId", "valueType": "string", "description": "Owning Unit/company identifier." },
    { "key": "cardType", "valueType": "enum", "description": "Canonical operated card type." },
    { "key": "contentType", "valueType": "enum", "description": "Domain content type or subtype." },
    { "key": "primitive", "valueType": "enum", "description": "Reusable content primitive such as venue, program, event, camp, or competition." },
    { "key": "title", "valueType": "string", "description": "Primary card title." },
    { "key": "description", "valueType": "text", "description": "Primary user-facing description/body." },
    { "key": "category", "valueType": "enum", "description": "Primary classification/category shown to users when relevant." },
    { "key": "status", "valueType": "enum", "description": "Canonical lifecycle/status display." },
    { "key": "activityState", "valueType": "enum", "description": "Activity/freshness state where separate from status." },
    { "key": "reviewState", "valueType": "enum", "description": "Review or approval state." },
    { "key": "visibility", "valueType": "enum", "description": "Public, operator, hidden, or internal visibility posture." },
    { "key": "board", "valueType": "object", "description": "Board, column, order, and lane placement." },
    { "key": "priority", "valueType": "number", "description": "Operational priority or rank." },
    { "key": "score", "valueType": "object", "description": "Canonical score bundle including ICE and score profile." },
    { "key": "quality", "valueType": "object", "description": "Quality, urgency, freshness, and uncertainty signals." },
    { "key": "evidence", "valueType": "object", "description": "Evidence required to support the card." },
    { "key": "source", "valueType": "object", "description": "Source URL, provenance, canonical content, and source authority data." },
    { "key": "lineage", "valueType": "object", "description": "Generated-from, version family, duplicate cluster, and refinement links." },
    { "key": "fingerprint", "valueType": "string", "description": "Deduplication fingerprint." },
    { "key": "metadata", "valueType": "object", "description": "Structured implementation metadata, internal unless explicitly surfaced." },
    { "key": "diagnostics", "valueType": "object", "description": "Failure, uncertainty, and validation diagnostics." },
    { "key": "facts", "valueType": "object", "description": "Extracted facts used to prepare publishable content." },
    { "key": "draft", "valueType": "object", "description": "Draft payload prepared for review or publication." },
    { "key": "media", "valueType": "object", "description": "Images, media summaries, and media candidates." },
    { "key": "website", "valueType": "url", "description": "Primary website URL." },
    { "key": "socialLinks", "valueType": "object", "description": "Social profile URLs." },
    { "key": "contact", "valueType": "object", "description": "Contact name, email, phone, and address data." },
    { "key": "location", "valueType": "object", "description": "Human-readable and structured location data." },
    { "key": "schedule", "valueType": "object", "description": "Dates, times, recurrence, or schedule blocks." },
    { "key": "audience", "valueType": "object", "description": "Audience and eligibility such as ages or visitor segment." },
    { "key": "provider", "valueType": "string", "description": "Provider, company, organization, or host name." },
    { "key": "price", "valueType": "object", "description": "Pricing or cost information." },
    { "key": "requirements", "valueType": "object", "description": "Prerequisites, equipment, eligibility, or safety requirements." },
    { "key": "tags", "valueType": "string[]", "description": "Hashtags, tags, topic hints, and cluster labels." },
    { "key": "file", "valueType": "object", "description": "Uploaded file metadata and content." },
    { "key": "owner", "valueType": "string", "description": "Human or system owner/creator." },
    { "key": "timestamps", "valueType": "object", "description": "Created, updated, generated, refreshed, submitted, scheduled, and completion timestamps." },
    { "key": "automation", "valueType": "object", "description": "Local job, prompt, model, adapter, and workflow automation data." },
    { "key": "feedback", "valueType": "object", "description": "Human feedback, accept/decline counts, annotations, and corrections." },
    { "key": "permissions", "valueType": "object", "description": "Permission and audit target data." },
    { "key": "publish", "valueType": "object", "description": "Publication, bridge, packet, and public verification state." }
  ],
