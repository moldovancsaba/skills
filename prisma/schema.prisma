// Trinity Formal Lifecycle State Machine (M1.2)
enum CandidateState {
  GENERATED   // Output of Generator stage
  REFINED     // Output of Refiner stage
  EVALUATED   // Output of Evaluator stage — eligible for frontier
  REWORK      // Returned to pipeline for another pass
  SUPPRESSED  // Dominated by sibling — excluded from frontier
  DELIVERED   // Action confirmed executed in reality (stronger than ACCEPTED)
  ARCHIVED    // Permanently removed from active pool
}

// Trinity Rework Routes (M1.2)
enum ReworkRoute {
  REVISE          // Rewrite for clarity or precision
  REGENERATE      // Full regeneration from evidence
  MERGE           // Combine with a sibling candidate
  ENRICH          // Add supporting context or grounding
  DOWNRANK_ONLY   // Keep in pool but lower frontier priority
  OLD_MODIFIED_UNRESOLVED
  DECLINE_INFORMED_REWORK
}

enum Role {
  SUPERADMIN
  OWNER
  ADMIN
  MEMBER
}

model MemoryCanon {
  id               String   @id @default(uuid()) @map("_id")
  memoryEntryId    String   @unique
  companyId        String
  scope            String   // CARD | TOPIC | GLOBAL
  sourceSignalId   String?
  sourceSignalType String?
  entityId         String?
  content          String
  weightInitial    Float    @default(1.0)
  weightFinal      Float    @default(1.0)
  status           String   @default("ACTIVE") // ACTIVE | SUPERSEDED | PRUNED | CONFLICT
  supersededBy     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  expiresAt        DateTime?

  @@index([companyId, scope, weightFinal, createdAt])
}

// M3.2: Typed decline classification enum (10 classes per spec §20)
enum DeclineClass {
  WRONG              // Factually incorrect
  DUPLICATE          // Same idea already exists
  TOO_VAGUE          // Not specific enough to act on → REWORK/ENRICH
  LOW_PRIORITY       // Valid but not important enough right now
  BAD_TIMING         // Good idea but wrong moment → DOWNRANK_ONLY
  NOT_ACTIONABLE     // Cannot be executed by the team → REWORK/REVISE
  MISSING_CONTEXT    // Needs more supporting information → REWORK/ENRICH
  IRRELEVANT         // Outside company strategy
  ALREADY_DONE       // Task already completed
  IGNORANT_OUTPUT    // AI hallucination or confabulation
}

// M3.2: Immutable decline event audit log
model DeclineEvent {
  id           String       @id @default(uuid()) @map("_id")
  checklistTaskId String    @map("nbaItemId")
  companyId    String
  declineClass DeclineClass
  comment      String?
  actorId      String?
  reworkRoute  String?      // ReworkRoute value if applicable
  createdAt    DateTime     @default(now())

  @@index([companyId, checklistTaskId])
  @@index([companyId, declineClass, createdAt])
}

// M4.1: Structured feedback memory with scoped lessons
model MemoryEntry {
  id             String   @id @default(uuid()) @map("_id")
  companyId      String
  scope          String   // GLOBAL | TOPIC | ITEM_FAMILY
  lessonType     String   // HARD_CONSTRAINT | SOFT_PREFERENCE | ANTI_PATTERN | DUPLICATE_HINT | SUCCESS_PATTERN
  lessonContent  String   // Human-readable lesson
  weight         Float    @default(1.0)
  topicHint      String?  // Topic label if scope=TOPIC
  itemFamilyId   String?  // versionFamilyId if scope=ITEM_FAMILY
  sourceEventId  String?  // FeedbackEvent ID that produced this lesson
  sourceEventType String? // DECLINE | ACCEPT | DELIVER | MODIFY_ACCEPT | COMMENT
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  expiresAt      DateTime?
  active         Boolean  @default(true)

  @@index([companyId, scope, lessonType, weight])
  @@index([companyId, topicHint, active])
  @@index([companyId, itemFamilyId, active])
}
