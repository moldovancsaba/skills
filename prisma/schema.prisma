generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Company {
  id                  String                @id @default(uuid()) @map("_id")
  name                String
  industry            String?
  industries          String[]              @default([])
  description         String?
  targetMarket        String?
  mainGoal            GoalType?
  createdAt           DateTime              @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  flashcards          Flashcard[]
  flashcardCorrections FlashcardCorrection[]
  hashtagFeedback     HashtagFeedback[]
  hashtagMaintenanceEvents HashtagMaintenanceEvent[]
  checklistTasks      ChecklistTask[]
  sources             Source[]
  goalcards           Goalcard[]
  goalcardCorrections GoalcardCorrection[]
  topics              Topic[]
  uploadedSourceFiles UploadedSourceFile[]
  workerConfig        Json?                 @default("{}")
  lastAIVisited       DateTime?
  users               User[]
  communicationSettings CommunicationSettings?
  allowedLanguages    String[]              @default(["English"])
  
  // State Snapshot Architecture (M4.0)
  intelligenceSnapshot IntelligenceSnapshot?
  strategicFeedback    StrategicFeedback[]
  pipelineJobs         PipelineJob[]
  citationSnapshots    CitationSnapshot[]
  workflowBlueprints   WorkflowBlueprint[]
  enrichmentPolicies   EnrichmentWaterfallPolicy[]
  aiWorkloadUsages     AiWorkloadUsage[]
  budgetPolicies       BudgetPolicy[]
  budgetEvents         BudgetEvent[]
  opportunitycards     Opportunitycard[]
  opportunityFeedback  OpportunitycardFeedback[]
  destinationInstances       DestinationInstance[]
  destinationWorkflowRuns    DestinationWorkflowRun[]
  destinationSourceDocuments DestinationSourceDocument[]
  destinationSourceAssets    DestinationSourceAsset[]
  destinationCandidates      DestinationCandidate[]
  destinationFactSnapshots   DestinationFactSnapshot[]
  destinationDrafts          DestinationDraft[]
  destinationArtifactLinks   DestinationArtifactLink[]
  destinationReviewPackets   DestinationReviewPacket[]
  destinationOutcomeMemories DestinationOutcomeMemory[]
  destinationReviewDecisions DestinationReviewDecision[]
  destinationWorkflowStageEvents DestinationWorkflowStageEvent[]
  destinationMissionPolicySnapshots DestinationMissionPolicySnapshot[]
  destinationMissionDefinitions     DestinationMissionDefinition[]
  destinationMissionDefinitionRevisions DestinationMissionDefinitionRevision[]
  destinationMissionRuns            DestinationMissionRun[]
  destinationMissionAttempts        DestinationMissionAttempt[]
  
  // Profile Validation Fields
  website             String?
  businessModel       String?
  productCategories   String[]              @default([])
  demographics        Json?                 @default("{}")
  competitors         Json?                 @default("[]")
  enabledDepartments  DepartmentKey[]       @default([])
}

model IntelligenceSnapshot {
  id                  String    @id @default(uuid()) @map("_id")
  companyId           String    @unique
  
  // Module Counts (Absolute Truth)
  dataIngressCount    Int       @default(0)
  topicSynthesisCount Int       @default(0)
  knowmoreCount       Int       @default(0)
  strategicGoalsCount Int       @default(0)
  checklistCount      Int       @default(0)
  tacticalBoardCount  Int       @default(0)
  reviewGatewayCount  Int       @default(0)
  
  // Core Metrics
  synthesisYield      Float     @default(0)
  confidenceAvg       Float     @default(0)
  iceScoreAvg         Float     @default(0)
  easeScoreAvg        Float     @default(0)
  
  // Operational State
  engineStatus        String    @default("OFFLINE")
  activeContext       String?
  activeTask          String?
  stage               String?
  analyticsHistory    Json?     @default("[]")
  scoreHealth         Json?     @default("{}")
  knowmoreHealth      Json?     @default("{}")
  observabilitySummary Json?    @default("{}")
  webappProjection    Json?     @default("{}")
  feedbackAnalytics   Json?     @default("{}")
  hashtagAnalytics    Json?     @default("{}")
  
  updatedAt           DateTime  @default(now()) @updatedAt
  company             Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model StrategicFeedback {
  id                  String      @id @default(uuid()) @map("_id")
  companyId           String
  entityType          String      // GOAL | TASK | KNOWLEDGE
  entityId            String
  
  action              ActionType
  annotation          String?
  modifiedTitle       String?
  modifiedDescription String?
  declineClass        DeclineClass?
  
  // Reconciliation State
  processedByAI       Boolean     @default(false)
  reconciledAt        DateTime?
  
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @default(now()) @updatedAt
  
  company             Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  @@index([companyId, processedByAI, createdAt])
}



model Feedback {
  id                  String      @id @default(uuid()) @map("_id")
  checklistTaskId     String      @map("nbaItemId")
  action              ActionType
  annotation          String?
  iceImpact           Float?
  processedByWorkerAt DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @default(now()) @updatedAt
  modifiedDescription String?
  modifiedTitle       String?
  // M3.2: Typed decline classification
  declineClass        DeclineClass?
  // M3.3: DELIVER metadata
  deliveryComment     String?     // High-value memory input on DELIVER
  actorId             String?     // User who performed the action
  checklistTask       ChecklistTask @relation(fields: [checklistTaskId], references: [id])
}

enum IntelligenceType {
  INTERNAL
  COMPETITOR
}

model Flashcard {
  id                      String                @id @default(uuid()) @map("_id")
  publicId                Int?                  @unique
  companyId               String
  title                   String
  body                    String
  confidence              Int                   @default(50)
  impact                  Int                   @default(5)
  weight                  Int                   @default(5)
  processingStatus        FlashcardProcessingStatus @default(DRAFT)
  activityState           FlashcardActivityState    @default(ACTIVE)
  confidenceScore         Float                 @default(50)
  status                  FlashcardStatus       @default(ACTIVE) // Legacy, keeping for migration
  createdBy               String?               @default("bootstrap-source")
  refreshedAt             DateTime              @default(now())
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @default(now()) @updatedAt
  generatedBody           String?
  generatedTitle          String?
  lastActionAt            DateTime?
  manualBody              String?
  manualTitle             String?
  reviewStatus            FlashcardReviewStatus @default(PENDING)
  userAnnotation          String?
  hashtags                String[]               @default([])
  hashtagMaintainedAt     DateTime?
  hashtagEvaluationPending Boolean              @default(true)
  lastHashtagError        String?
  evidence                Json?
  citationSnapshotIds     String[]               @default([])
  conflictDetected        Boolean                @default(false)
  conflictSummary         String?
  feedbackConfidenceDelta Int                   @default(0)
  feedbackWeightDelta     Int                   @default(0)
  fingerprint             String?
  kind                    String                @default("SUMMARY")
  appVersion              String?               @default("0.16.0")
  brainVersion            String?               @default("local-brain@0.16.0")
  generatedAt             DateTime?
  promptVersion           String?               @default("flashcard-policy@0.16.0")
  promptHash              String?
  promptName              String?               @default("flashcard-generation")
  modelName               String?               @default("granite-3.1-8b")
  modelVersion            String?
  temperature             Float?                @default(0.7)
  createdByRunId          String?
  cycleRunId              String?
  intelligenceType        IntelligenceType      @default(INTERNAL)
  departmentKey          DepartmentKey?
  lastAuditedAt           DateTime? // Legacy shared audit timestamp. Deprecated in favor of purpose-specific fields.
  lastRescoredAt          DateTime?
  lastTaxonomyAuditedAt   DateTime?
  lastCorrectionReconciledAt DateTime?
  iceScore                Float                 @default(0)
  scoreProfile            Json?                 @default("{}")
  versionFamilyId         String?
  duplicateClusterId      String?
  generatedFromIds        String[]               @default([])
  refinedFromId           String?
  company                 Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actions                 FlashcardAction[]
  corrections             FlashcardCorrection[]
  sources                 FlashcardSource[]

  @@unique([companyId, fingerprint])
  @@index([companyId, processingStatus, cycleRunId])
  @@index([companyId, duplicateClusterId])
  @@index([companyId, versionFamilyId])
}

model CitationSnapshot {
  id            String   @id @default(uuid()) @map("_id")
  companyId      String
  sourceId       String?
  sourcePublicId Int?
  sourceType     String?
  sourceName     String?
  normalizedUrl  String?
  excerpt        String
  contentHash    String
  fetchedAt      DateTime
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, sourceId, fetchedAt])
  @@index([companyId, normalizedUrl, fetchedAt])
  @@index([companyId, contentHash])
}

model FlashcardAction {
  id            String              @id @default(uuid()) @map("_id")
  flashcardId   String
  action        FlashcardActionType
  annotation    String?
  previousTitle String?
  previousBody  String?
  modifiedTitle String?
  modifiedBody  String?
  actedBy       String?             @default("webapp-user")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @default(now()) @updatedAt
  flashcard     Flashcard           @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@index([flashcardId, createdAt])
}

model FlashcardCorrection {
  id             String                  @id @default(uuid()) @map("_id")
  companyId      String
  flashcardId    String?
  sourceType     FlashcardSourceType?
  sourceId       String?
  sourcePublicId Int?
  sourceName     String?
  correctionType FlashcardCorrectionType
  note           String?
  actedBy        String?                 @default("webapp-user")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @default(now()) @updatedAt
  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  flashcard      Flashcard?              @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([flashcardId, createdAt])
  @@index([sourceType, sourceId])
}

model FlashcardSource {
  id             String              @id @default(uuid()) @map("_id")
  flashcardId    String
  sourceType     FlashcardSourceType
  sourceId       String
  sourcePublicId Int?
  sourceName     String
  relationRole   FlashcardSourceRole @default(PRIMARY)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @default(now()) @updatedAt
  flashcard     Flashcard           @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([flashcardId, sourceType, sourceId])
  @@index([sourceType, sourceId])
}

model Goalcard {
  id                      String                @id @default(uuid()) @map("_id")
  publicId                Int?                  @unique
  companyId               String
  title                   String
  body                    String
  confidence              Int                   @default(50)
  impact                  Int                   @default(5)
  weight                  Int                   @default(5)
  processingStatus        GoalcardProcessingStatus @default(DRAFT)
  activityState           GoalcardActivityState    @default(ACTIVE)
  confidenceScore         Float                 @default(50)
  createdBy               String?               @default("classifier-agent")
  refreshedAt             DateTime              @default(now())
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @default(now()) @updatedAt
  generatedBody           String?
  generatedTitle          String?
  lastActionAt            DateTime?
  manualBody              String?
  manualTitle             String?
  userAnnotation          String?
  hashtags                String[]               @default([])
  hashtagMaintainedAt     DateTime?
  hashtagEvaluationPending Boolean              @default(true)
  lastHashtagError        String?
  evidence                Json?
  feedbackConfidenceDelta Int                   @default(0)
  feedbackWeightDelta     Int                   @default(0)
  fingerprint             String?
  kind                    String                @default("GOAL")
  appVersion              String?               @default("0.16.0")
  brainVersion            String?               @default("local-brain@0.16.0")
  generatedAt             DateTime?
  intelligenceType        IntelligenceType      @default(INTERNAL)
  departmentKey          DepartmentKey?
  lastAuditedAt           DateTime? // Legacy shared audit timestamp. Deprecated in favor of purpose-specific fields.
  lastRescoredAt          DateTime?
  lastTaxonomyAuditedAt   DateTime?
  iceScore                Float                 @default(0)
  scoreProfile            Json?                 @default("{}")
  company                 Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actions                 GoalcardAction[]
  corrections             GoalcardCorrection[]
  sources                 GoalcardSource[]

  @@unique([companyId, fingerprint])
  @@index([companyId, processingStatus])
}

model GoalcardAction {
  id            String              @id @default(uuid()) @map("_id")
  goalcardId    String
  action        GoalcardActionType
  annotation    String?
  previousTitle String?
  previousBody  String?
  modifiedTitle String?
  modifiedBody  String?
  actedBy       String?             @default("webapp-user")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @default(now()) @updatedAt
  goalcard      Goalcard            @relation(fields: [goalcardId], references: [id], onDelete: Cascade)

  @@index([goalcardId, createdAt])
}

model GoalcardCorrection {
  id             String                  @id @default(uuid()) @map("_id")
  companyId      String
  goalcardId     String?
  sourceType     FlashcardSourceType?
  sourceId       String?
  sourcePublicId Int?
  sourceName     String?
  correctionType FlashcardCorrectionType
  note           String?
  actedBy        String?                 @default("webapp-user")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @default(now()) @updatedAt
  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  goalcard       Goalcard?               @relation(fields: [goalcardId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([goalcardId, createdAt])
  @@index([sourceType, sourceId])
}

model GoalcardSource {
  id             String              @id @default(uuid()) @map("_id")
  goalcardId     String
  sourceType     FlashcardSourceType
  sourceId       String
  sourceName     String
  relationRole   FlashcardSourceRole @default(PRIMARY)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @default(now()) @updatedAt
  goalcard       Goalcard            @relation(fields: [goalcardId], references: [id], onDelete: Cascade)

  @@unique([goalcardId, sourceType, sourceId])
  @@index([sourceType, sourceId])
}


model ChecklistTask {
  id                 String     @id @default(uuid()) @map("_id")
  companyId          String
  title              String
  description        String?
  impact             Int        @default(5)
  confidence         Int        @default(50)
  ease               Int        @default(5)
  iceScore           Float      @default(0)
  processingStatus   ChecklistProcessingStatus @default(DRAFT)
  activityState      ChecklistActivityState    @default(ACTIVE)
  confidenceScore    Float      @default(50)
  status             ChecklistStatus  @default(PENDING) // Legacy
  userAnnotation     String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @default(now()) @updatedAt
  scheduledDate      DateTime?
  createdBy          String?
  sourceFlashcardIds String[]   @default([])
  publicId           Int?       @unique
  appVersion         String?    @default("0.16.0")
  brainVersion       String?    @default("local-brain@0.16.0")
  generatedAt        DateTime?
  hashtags           String[]   @default([])
  lastAuditedAt      DateTime? // Legacy shared audit timestamp. Deprecated in favor of purpose-specific fields.
  lastRescoredAt     DateTime?
  lastTaxonomyAuditedAt DateTime?
  hashtagMaintainedAt DateTime?
  hashtagEvaluationPending Boolean @default(true)
  lastHashtagError   String?
  promptVersion      String?    @default("checklist-policy@0.16.0")
  promptHash         String?
  promptName         String?    @default("checklist-generation")
  modelName          String?    @default("granite-3.1-8b")
  modelVersion       String?
  temperature        Float?     @default(0.7)
  createdByRunId     String?
  cycleRunId         String?
  feedback           Feedback[]
  fingerprint        String?
  kind               String?    @default("TASK")
  company            Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Trinity Lifecycle State Machine (M1.2)
  candidateState     CandidateState @default(GENERATED)
  reworkRoute        ReworkRoute?
  // Trinity Scoring dimensions (M2.3)
  qualityScore       Float?     // absolute quality 0-1
  urgencyScore       Float?     // time-sensitivity 0-1
  freshnessScore     Float?     // evidence freshness 0-1
  feedbackScore      Float?     @default(0) // cumulative feedback signal
  scoreProfile       Json?      @default("{}")
  evaluationReason   String?    // Evaluator's stated reason for disposition
  rottenAt           DateTime?  // when this candidate becomes stale and needs rework
  // Trinity Lineage (M1.3)
  versionFamilyId    String?    // groups all versions of the same conceptual candidate
  duplicateClusterId String?    // links semantic duplicate siblings
  generatedFromIds   String[]   @default([]) // source evidence IDs
  refinedFromId      String?    // the generated candidate this was refined from
  kanbanColumn       ChecklistKanbanColumn @default(IDEABANK)
  sortOrder          Float      @default(0)
  manualLaneOverrideAt DateTime?
  manualLaneCooldownUntil DateTime?
  manualLaneFloorColumn ChecklistKanbanColumn?
  manualLaneOverrideBy String?
  departmentKey      DepartmentKey?

  @@unique([companyId, fingerprint])
  @@index([companyId, processingStatus, cycleRunId])
  @@index([companyId, candidateState, iceScore])
  @@index([companyId, duplicateClusterId])
  @@index([companyId, versionFamilyId])
  @@index([companyId, kanbanColumn, sortOrder])
  @@index([companyId, manualLaneCooldownUntil])
  @@map("ChecklistTask")
}

model Opportunitycard {
  id                 String     @id @default(uuid()) @map("_id")
  publicId           Int?       @unique
  companyId          String
  companyName        String
  title              String
  body               String
  website            String?
  linkedinUrl        String?
  instagramUrl       String?
  facebookUrl        String?
  xUrl               String?
  contactInfo        Json?      @default("{}")
  location           String?
  salesGeographies   String[]   @default([])
  coreOffer          String?
  financialBackground String?
  fitRationale       String?
  opportunityType    OpportunityType @default(PROSPECT)
  departmentKey      DepartmentKey   @default(SALES)
  confidence         Int        @default(50)
  confidenceScore    Float      @default(50)
  impact             Int        @default(5)
  weight             Int        @default(5)
  iceScore           Float      @default(0)
  processingStatus   OpportunitycardProcessingStatus @default(DRAFT)
  activityState      OpportunitycardActivityState    @default(ACTIVE)
  userAnnotation     String?
  evaluationReason   String?
  declineCount       Int        @default(0)
  acceptanceCount    Int        @default(0)
  feedbackScore      Float      @default(0)
  createdBy          String?    @default("local-opportunity-miner")
  sourceFlashcardIds String[]   @default([])
  generatedFromIds   String[]   @default([])
  fingerprint        String?
  versionFamilyId    String?
  duplicateClusterId String?
  refinedFromId      String?
  scoreProfile       Json?      @default("{}")
  evidence           Json?      @default("{}")
  hashtags           String[]   @default([])
  kanbanColumn       ChecklistKanbanColumn @default(IDEABANK)
  sortOrder          Float      @default(0)
  manualLaneOverrideAt DateTime?
  manualLaneCooldownUntil DateTime?
  manualLaneFloorColumn ChecklistKanbanColumn?
  manualLaneOverrideBy String?
  promptVersion      String?
  promptHash         String?
  promptName         String?
  modelName          String?
  modelVersion       String?
  temperature        Float?
  generatedAt        DateTime?
  refreshedAt        DateTime   @default(now())
  lastActionAt       DateTime?
  rottenAt           DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @default(now()) @updatedAt
  company            Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  feedback           OpportunitycardFeedback[]

  @@unique([companyId, fingerprint])
  @@index([companyId, processingStatus, kanbanColumn, sortOrder])
  @@index([companyId, departmentKey, kanbanColumn, sortOrder])
  @@index([companyId, duplicateClusterId])
  @@index([companyId, versionFamilyId])
}

model OpportunitycardFeedback {
  id                 String    @id @default(uuid()) @map("_id")
  companyId          String
  opportunitycardId  String
  action             OpportunitycardActionType
  declineReason      OpportunitycardDeclineReason?
  annotation         String?
  modifiedCompanyName String?
  modifiedTitle      String?
  modifiedBody       String?
  modifiedWebsite    String?
  modifiedLocation   String?
  modifiedCoreOffer  String?
  modifiedFitRationale String?
  actedBy            String?   @default("webapp-user")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunitycard    Opportunitycard @relation(fields: [opportunitycardId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([opportunitycardId, createdAt])
}

enum ChecklistKanbanColumn {
  IDEABANK
  ROADMAP
  BACKLOG
  TODO
  CHECKLIST
}

model HashtagFeedback {
  id         String                @id @default(uuid()) @map("_id")
  companyId  String
  entityType HashtagEntityType
  entityId   String
  tag        String
  action     HashtagFeedbackAction
  note       String?
  createdBy  String?               @default("webapp-user")
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @default(now()) @updatedAt
  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, entityType, entityId, createdAt])
  @@index([companyId, tag, createdAt])
}

model HashtagMaintenanceEvent {
  id         String                @id @default(uuid()) @map("_id")
  companyId  String
  entityType HashtagEntityType
  entityId   String
  status     HashtagMaintenanceStatus
  note       String?
  createdBy  String?               @default("local-ai")
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @default(now()) @updatedAt
  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, entityType, entityId, createdAt])
}


model Source {
  id              String   @id @default(uuid()) @map("_id")
  companyId       String
  publicId        Int?     @unique
  content         String
  confidence      Int      @default(5)
  impact          Int      @default(5)
  weight          Int      @default(5)
  confidenceScore Float    @default(5)
  iceScore        Float    @default(0)
  scoreProfile    Json?    @default("{}")
  canonicalContent String?
  canonicalContentHash String?
  canonicalizerVersion String?   @default("v1.4.0")
  hashtags        String[] @default([])
  hashtagMaintainedAt DateTime?
  hashtagEvaluationPending Boolean @default(true)
  lastHashtagError String?
  entityTag       String?
  aiClusters      String[] @default([])
  metadata        Json?
  legacyOriginKey String?
  processingStatus SourceProcessingStatus @default(DRAFT)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  // Trinity Evidence Model fields (M1.1)
  sourceType      String?  @default("WEB") // WEB | UPLOAD | BRIDGE | MANUAL
  provenance      String?  // origin URL or reference
  topicHints      String[] @default([]) // topic label hints for Generator
  freshnessWindowDays Int? @default(30) // how many days this evidence is considered fresh
  intelligenceType    IntelligenceType @default(INTERNAL)
  departmentKey       DepartmentKey?
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, publicId, createdAt])
  @@index([companyId, legacyOriginKey])
  @@index([companyId, canonicalContentHash])
  @@index([companyId, processingStatus, updatedAt])
}

enum SourceProcessingStatus {
  DRAFT
  CHECKED
  VERIFIED
}

model Topic {
  id        String   @id @default(uuid()) @map("_id")
  companyId String
  label     String
  confidence      Int      @default(5)
  impact          Int      @default(5)
  weight          Int      @default(5)
  confidenceScore Float    @default(5)
  iceScore        Float    @default(0)
  scoreProfile    Json?    @default("{}")
  hashtags  String[] @default([])
  hashtagMaintainedAt DateTime?
  hashtagEvaluationPending Boolean @default(true)
  lastHashtagError String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, active, sortOrder])
  @@unique([companyId, label])
}

model PublicIdCounter {
  scope     String   @id @map("_id")
  value     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt
}

model GlobalSetting {
  id        String   @id @default(uuid()) @map("_id")
  key       String   @unique
  value     Json
  updatedAt DateTime @default(now()) @updatedAt
}

model ModelConfig {
  id          String   @id @default(uuid()) @map("_id")
  stage       String   // DRAFT | WRITE | JUDGE
  modelName   String
  temperature Float    @default(0.7)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([stage, modelName])
}

model SystemCommand {
  id        String   @id @default(uuid()) @map("_id")
  command   String   // SYNC | PURGE | SCAN | RESTART
  payload   Json?    @default("{}")
  status    String   @default("PENDING") // PENDING | PROCESSING | DONE | FAILED
  issuedAt  DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  error     String?

  @@index([status, issuedAt])
}

model PipelineJob {
  id               String              @id @default(uuid()) @map("_id")
  companyId        String
