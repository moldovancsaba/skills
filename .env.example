# Neon PostgreSQL Connection
# Get your connection string from https://console.neon.tech
# Format: postgresql://user:pass@host.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/CHECKLIST?sslmode=require"

# Generate a secure secret for auth
AUTH_SECRET="your-secret-key-here-change-in-production"

# GitHub OAuth (optional - for production)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""