generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Company {
  id                  String                @id @default(uuid()) @map("_id")
  name                String
  industry            String?
  industries          String[]              @default([])
  description         String?
  targetMarket        String?
  mainGoal            GoalType?
  createdAt           DateTime              @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  competitors         Competitor[]
  customers           Customer[]
  flashcards          Flashcard[]
  flashcardCorrections FlashcardCorrection[]
  hashtagFeedback     HashtagFeedback[]
  nbaItems            NBAItem[]
  products            Product[]
  sources             Source[]
  topics              Topic[]
  uploadedSourceFiles UploadedSourceFile[]
  users               User[]
}

model Competitor {
  id             String   @id @default(uuid()) @map("_id")
  companyId      String
  name           String
  urls           String[]
  pricing        String?
  strengths      String[]
  weaknesses     String[]
  positioning    String?
  watchedContent Json?
  createdAt      DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  publicId       Int?     @unique
  hashtags       String[] @default([])
  entityTag      String?
  company        Company  @relation(fields: [companyId], references: [id])
}

model Customer {
  id            String   @id @default(uuid()) @map("_id")
  companyId     String
  name          String
  email         String?
  segments      String[]
  painPoints    String[]
  channels      String[]
  lifetimeValue Float?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  publicId      Int?     @unique
  hashtags      String[] @default([])
  entityTag     String?
  company       Company  @relation(fields: [companyId], references: [id])
}

model Feedback {
  id                  String     @id @default(uuid()) @map("_id")
  nbaItemId           String
  action              ActionType
  annotation          String?
  iceImpact           Float?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @default(now()) @updatedAt
  modifiedDescription String?
  modifiedTitle       String?
  nbaItem             NBAItem    @relation(fields: [nbaItemId], references: [id])
}

model Flashcard {
  id                      String                @id @default(uuid()) @map("_id")
  publicId                Int?                  @unique
  companyId               String
  title                   String
  body                    String
  confidence              Int                   @default(50)
  impact                  Int                   @default(5)
  weight                  Int                   @default(5)
  status                  FlashcardStatus       @default(ACTIVE)
  createdBy               String?               @default("bootstrap-source")
  refreshedAt             DateTime              @default(now())
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @default(now()) @updatedAt
  generatedBody           String?
  generatedTitle          String?
  lastActionAt            DateTime?
  manualBody              String?
  manualTitle             String?
  reviewStatus            FlashcardReviewStatus @default(PENDING)
  userAnnotation          String?
  hashtags                String[]               @default([])
  evidence                Json?
  feedbackConfidenceDelta Int                   @default(0)
  feedbackWeightDelta     Int                   @default(0)
  fingerprint             String?
  kind                    FlashcardKind         @default(SUMMARY)
  appVersion              String?               @default("0.8.0")
  brainVersion            String?               @default("local-brain@0.8.0")
  generatedAt             DateTime?
  promptVersion           String?               @default("flashcard-policy@0.8.0")
  company                 Company               @relation(fields: [companyId], references: [id])
  actions                 FlashcardAction[]
  corrections             FlashcardCorrection[]
  sources                 FlashcardSource[]

  @@unique([companyId, fingerprint])
}

model FlashcardAction {
  id            String              @id @default(uuid()) @map("_id")
  flashcardId   String
  action        FlashcardActionType
  annotation    String?
  previousTitle String?
  previousBody  String?
  modifiedTitle String?
  modifiedBody  String?
  actedBy       String?             @default("webapp-user")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @default(now()) @updatedAt
  flashcard     Flashcard           @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@index([flashcardId, createdAt])
}

model FlashcardCorrection {
  id             String                  @id @default(uuid()) @map("_id")
  companyId      String
  flashcardId    String?
  sourceType     FlashcardSourceType?
  sourceId       String?
  sourcePublicId Int?
  sourceName     String?
  correctionType FlashcardCorrectionType
  note           String?
  actedBy        String?                 @default("webapp-user")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @default(now()) @updatedAt
  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  flashcard      Flashcard?              @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([flashcardId, createdAt])
  @@index([sourceType, sourceId])
}

model FlashcardSource {
  id             String              @id @default(uuid()) @map("_id")
  flashcardId    String
  sourceType     FlashcardSourceType
  sourceId       String
  sourcePublicId Int?
  sourceName     String
  relationRole   FlashcardSourceRole @default(PRIMARY)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @default(now()) @updatedAt
  flashcard     Flashcard           @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([flashcardId, sourceType, sourceId])
  @@index([sourceType, sourceId])
}

model NBAItem {
  id                 String     @id @default(uuid()) @map("_id")
  companyId          String
  title              String
  description        String?
  impact             Int        @default(5)
  confidence         Int        @default(50)
  ease               Int        @default(5)
  iceScore           Float      @default(0)
  status             NBAStatus  @default(PENDING)
  userAnnotation     String?
  createdAt          DateTime   @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  scheduledDate      DateTime?
  createdBy          String?
  sourceFlashcardIds String[]   @default([])
  publicId           Int?       @unique
  appVersion         String?    @default("0.8.0")
  brainVersion       String?    @default("local-brain@0.8.0")
  generatedAt        DateTime?
  hashtags           String[]   @default([])
  promptVersion      String?    @default("nba-policy@0.8.0")
  feedback           Feedback[]
  company            Company    @relation(fields: [companyId], references: [id])
}

model HashtagFeedback {
  id         String                @id @default(uuid()) @map("_id")
  companyId  String
  entityType HashtagEntityType
  entityId   String
  tag        String
  action     HashtagFeedbackAction
  note       String?
  createdBy  String?               @default("webapp-user")
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @default(now()) @updatedAt
  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, entityType, entityId, createdAt])
  @@index([companyId, tag, createdAt])
}

model Product {
  id          String   @id @default(uuid()) @map("_id")
  companyId   String
  name        String
  description String?
  pricing     String?
  features    String[]
  urls        String[]
  createdAt   DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  publicId    Int?     @unique
  hashtags    String[] @default([])
  entityTag   String?
  company     Company  @relation(fields: [companyId], references: [id])
}

model Source {
  id              String   @id @default(uuid()) @map("_id")
  companyId       String
  publicId        Int?     @unique
  content         String
  hashtags        String[] @default([])
  entityTag       String?
  aiClusters      String[] @default([])
  metadata        Json?
  legacyOriginKey String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, publicId, createdAt])
  @@index([companyId, legacyOriginKey])
}

model Topic {
  id        String   @id @default(uuid()) @map("_id")
  companyId String
  label     String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, active, sortOrder])
  @@unique([companyId, label])
}

model PublicIdCounter {
  scope     String   @id @map("_id")
  value     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt
}

model UploadedSourceFile {
  id        String   @id @default(uuid()) @map("_id")
  publicId  Int?     @unique
  companyId String
  name      String
  hashtags  String[] @default([])
  entityTag String?
  mimeType  String
  sizeBytes Int
  content   Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model User {
  id             String   @id @default(uuid()) @map("_id")
  email          String
  name           String?
  companyId      String
  role           Role     @default(MEMBER)
  invitedAt      DateTime?
  invitedByEmail String?
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  company        Company  @relation(fields: [companyId], references: [id])

  @@unique([email, companyId])
}

enum ActionType {
  ACCEPT
  DECLINE
  MODIFY_ACCEPT
}

enum FlashcardActionType {
  ACCEPT
  DECLINE
  MODIFY_ACCEPT
}

enum FlashcardCorrectionType {
  HIDE
  MARK_WRONG
  PIN
  REQUEST_REFRESH
  SUPPRESS_SOURCE
}

enum HashtagEntityType {
  SOURCE
  FLASHCARD
  CHECKLIST
}

enum HashtagFeedbackAction {
  USER_REMOVE
  USER_ADD
  AI_ADD
  AI_REJECT
  AI_ACCEPT
}

enum FlashcardKind {
  SUMMARY
  EXPLANATION
  COMPARISON
  NEWS
  CONCLUSION
  EVALUATION
  OPINION
  JUDGMENT
  RECOMMENDATION
  RESEARCH
  FORECAST
  STOCK
  GOSSIP
  PRICE
}

enum FlashcardReviewStatus {
  PENDING
  ACCEPTED
  DECLINED
  MODIFIED_ACCEPTED
}

enum FlashcardSourceRole {
  PRIMARY
  SUPPORTING
  MERGED_FROM
}

enum FlashcardSourceType {
  SOURCE
  PRODUCT
  CUSTOMER
  COMPETITOR
  AGENT_FOUND
  FILE
}

enum FlashcardStatus {
  ACTIVE
  STALE
  ARCHIVED
}

enum GoalType {
  GROW_REVENUE
  LAUNCH_PRODUCT
  ENTER_NEW_MARKET
  BUILD_AWARENESS
  GENERATE_LEADS
}

enum NBAStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
}

enum Role {
  SUPERADMIN
  OWNER
  ADMIN
  MEMBER
}
