generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  companyId String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Company {
  id           String   @id @default(uuid())
  name         String
  industry    String?
  description String?
  targetMarket String?
  mainGoal    GoalType?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users        User[]
  products    Product[]
  customers   Customer[]
  competitors Competitor[]
  flashcards  Flashcard[]
  nbaItems    NBAItem[]
}

enum GoalType {
  GROW_REVENUE
  LAUNCH_PRODUCT
  ENTER_NEW_MARKET
  BUILD_AWARENESS
  GENERATE_LEADS
}

model Product {
  id          String   @id @default(uuid())
  publicId    Int?     @unique
  companyId   String
  name        String
  description String?
  pricing    String?
  features   String[]
  urls       String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
}

model Customer {
  id            String   @id @default(uuid())
  publicId      Int?     @unique
  companyId     String
  name          String
  email        String?
  segments     String[]
  painPoints   String[]
  channels    String[]
  lifetimeValue Float?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
}

model Competitor {
  id           String   @id @default(uuid())
  publicId     Int?     @unique
  companyId   String
  name        String
  urls        String[]
  pricing    String?
  strengths  String[]
  weaknesses String[]
  positioning String?
  watchedContent Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
}

model Flashcard {
  id              String                @id @default(uuid())
  publicId        Int?                  @unique
  companyId       String
  kind            FlashcardKind         @default(SUMMARY)
  fingerprint     String?
  title           String
  body            String
  generatedTitle  String?
  generatedBody   String?
  manualTitle     String?
  manualBody      String?
  evidence        Json?
  confidence      Int                   @default(50)
  impact          Int                   @default(5)
  weight          Int                   @default(5)
  feedbackWeightDelta Int               @default(0)
  feedbackConfidenceDelta Int           @default(0)
  status          FlashcardStatus       @default(ACTIVE)
  reviewStatus    FlashcardReviewStatus @default(PENDING)
  userAnnotation  String?
  lastActionAt    DateTime?
  createdBy       String?               @default("bootstrap-source")
  refreshedAt     DateTime              @default(now())
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  company Company           @relation(fields: [companyId], references: [id])
  sources FlashcardSource[]
  actions FlashcardAction[]

  @@unique([companyId, fingerprint])
}

model FlashcardSource {
  id             String              @id @default(uuid())
  flashcardId    String
  sourceType     FlashcardSourceType
  sourceId       String
  sourcePublicId Int?
  sourceName     String
  relationRole   FlashcardSourceRole @default(PRIMARY)
  createdAt      DateTime            @default(now())

  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([flashcardId, sourceType, sourceId])
  @@index([sourceType, sourceId])
}

enum FlashcardKind {
  SUMMARY
  EXPLANATION
  COMPARISON
  NEWS
  CONCLUSION
  EVALUATION
  OPINION
  JUDGMENT
  RECOMMENDATION
  RESEARCH
  FORECAST
  STOCK
  GOSSIP
  PRICE
}

enum FlashcardStatus {
  ACTIVE
  STALE
  ARCHIVED
}

enum FlashcardReviewStatus {
  PENDING
  ACCEPTED
  DECLINED
  MODIFIED_ACCEPTED
}

enum FlashcardSourceType {
  PRODUCT
  CUSTOMER
  COMPETITOR
  AGENT_FOUND
}

enum FlashcardSourceRole {
  PRIMARY
  SUPPORTING
  MERGED_FROM
}

model FlashcardAction {
  id            String              @id @default(uuid())
  flashcardId    String
  action         FlashcardActionType
  annotation     String?
  previousTitle  String?
  previousBody   String?
  modifiedTitle  String?
  modifiedBody   String?
  actedBy        String?             @default("webapp-user")
  createdAt      DateTime            @default(now())

  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@index([flashcardId, createdAt])
}

enum FlashcardActionType {
  ACCEPT
  DECLINE
  MODIFY_ACCEPT
}

model NBAItem {
  id             String     @id @default(uuid())
  companyId      String
  title          String
  description    String?
  sourceFlashcardIds String[] @default([])
  impact         Int         @default(5)
  confidence     Int         @default(50)
  ease           Int         @default(5)
  iceScore       Float       @default(0)
  status         NBAStatus  @default(PENDING)
  userAnnotation String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  scheduledDate DateTime?
  createdBy     String?

  company  Company  @relation(fields: [companyId], references: [id])
  feedbacks Feedback[]
}

enum NBAStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
}

model Feedback {
  id         String      @id @default(uuid())
  nbaItemId  String
  action     ActionType
  annotation String?
  iceImpact  Float?
  createdAt  DateTime    @default(now())

  nbaItem NBAItem @relation(fields: [nbaItemId], references: [id])
}

model PublicIdCounter {
  scope     String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

enum ActionType {
  ACCEPT
  DECLINE
}
