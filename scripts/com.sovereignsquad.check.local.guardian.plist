<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sovereignsquad.check.local.guardian</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/Shared/Projects/checklist/bin/check-local-guardian</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/Shared/Projects/checklist</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>CHECK_RUNNER_ID</key>
        <string>check.local.guardian</string>
        <key>CHECK_RUNNER_NAME</key>
        <string>CHECK Local Guardian</string>
        <key>CHECK_RUNNER_KIND</key>
        <string>continuous</string>
    </dict>

    <!-- Auto-start at login and auto-restart on exit -->
    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- Throttle immediately if crashing very fast -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- Log stdout / stderr -->
    <key>StandardOutPath</key>
    <string>/Users/Shared/Projects/checklist/logs/guardian-launchd.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/Shared/Projects/checklist/logs/guardian-launchd-error.log</string>
</dict>
</plist>
