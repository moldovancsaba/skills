generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Company {
  id                  String                @id @default(uuid()) @map("_id")
  name                String
  industry            String?
  industries          String[]              @default([])
  description         String?
  targetMarket        String?
  mainGoal            GoalType?
  createdAt           DateTime              @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  flashcards          Flashcard[]
  flashcardCorrections FlashcardCorrection[]
  hashtagFeedback     HashtagFeedback[]
  hashtagMaintenanceEvents HashtagMaintenanceEvent[]
  nbaItems            NBAItem[]
  sources             Source[]
  topics              Topic[]
  uploadedSourceFiles UploadedSourceFile[]
  creativeDrafts      CreativeDraft[]
  workerConfig        Json?                 @default("{}")
  lastAIVisited       DateTime?
  users               User[]
  communicationSettings CommunicationSettings?
  allowedLanguages    String[]              @default(["English"])
  
  // Profile Validation Fields
  website             String?
  businessModel       String?
  productCategories   String[]              @default([])
  demographics        Json?                 @default("{}")
  competitors         Json?                 @default("[]")
}



model Feedback {
  id                  String     @id @default(uuid()) @map("_id")
  nbaItemId           String
  action              ActionType
  annotation          String?
  iceImpact           Float?
  processedByWorkerAt DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @default(now()) @updatedAt
  modifiedDescription String?
  modifiedTitle       String?
  nbaItem             NBAItem    @relation(fields: [nbaItemId], references: [id])
}

model Flashcard {
  id                      String                @id @default(uuid()) @map("_id")
  publicId                Int?                  @unique
  companyId               String
  title                   String
  body                    String
  confidence              Int                   @default(50)
  impact                  Int                   @default(5)
  weight                  Int                   @default(5)
  processingStatus        FlashcardProcessingStatus @default(DRAFT)
  activityState           FlashcardActivityState    @default(ACTIVE)
  confidenceScore         Float                 @default(50)
  status                  FlashcardStatus       @default(ACTIVE) // Legacy, keeping for migration
  createdBy               String?               @default("bootstrap-source")
  refreshedAt             DateTime              @default(now())
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @default(now()) @updatedAt
  generatedBody           String?
  generatedTitle          String?
  lastActionAt            DateTime?
  manualBody              String?
  manualTitle             String?
  reviewStatus            FlashcardReviewStatus @default(PENDING)
  userAnnotation          String?
  hashtags                String[]               @default([])
  hashtagMaintainedAt     DateTime?
  hashtagEvaluationPending Boolean              @default(true)
  lastHashtagError        String?
  evidence                Json?
  feedbackConfidenceDelta Int                   @default(0)
  feedbackWeightDelta     Int                   @default(0)
  fingerprint             String?
  kind                    String                @default("SUMMARY")
  appVersion              String?               @default("0.8.0")
  brainVersion            String?               @default("local-brain@0.8.0")
  generatedAt             DateTime?
  promptVersion           String?               @default("flashcard-policy@1.4.0")
  promptHash              String?
  promptName              String?               @default("flashcard-generation")
  modelName               String?               @default("granite-3.1-8b")
  modelVersion            String?
  temperature             Float?                @default(0.7)
  createdByRunId          String?
  cycleRunId              String?
  company                 Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actions                 FlashcardAction[]
  corrections             FlashcardCorrection[]
  sources                 FlashcardSource[]

  @@unique([companyId, fingerprint])
  @@index([companyId, processingStatus, cycleRunId])
}

model FlashcardAction {
  id            String              @id @default(uuid()) @map("_id")
  flashcardId   String
  action        FlashcardActionType
  annotation    String?
  previousTitle String?
  previousBody  String?
  modifiedTitle String?
  modifiedBody  String?
  actedBy       String?             @default("webapp-user")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @default(now()) @updatedAt
  flashcard     Flashcard           @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@index([flashcardId, createdAt])
}

model FlashcardCorrection {
  id             String                  @id @default(uuid()) @map("_id")
  companyId      String
  flashcardId    String?
  sourceType     FlashcardSourceType?
  sourceId       String?
  sourcePublicId Int?
  sourceName     String?
  correctionType FlashcardCorrectionType
  note           String?
  actedBy        String?                 @default("webapp-user")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @default(now()) @updatedAt
  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  flashcard      Flashcard?              @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([flashcardId, createdAt])
  @@index([sourceType, sourceId])
}

model FlashcardSource {
  id             String              @id @default(uuid()) @map("_id")
  flashcardId    String
  sourceType     FlashcardSourceType
  sourceId       String
  sourcePublicId Int?
  sourceName     String
  relationRole   FlashcardSourceRole @default(PRIMARY)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @default(now()) @updatedAt
  flashcard     Flashcard           @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([flashcardId, sourceType, sourceId])
  @@index([sourceType, sourceId])
}

model NBAItem {
  id                 String     @id @default(uuid()) @map("_id")
  companyId          String
  title              String
  description        String?
  impact             Int        @default(5)
  confidence         Int        @default(50)
  ease               Int        @default(5)
  iceScore           Float      @default(0)
  processingStatus   NBAProcessingStatus @default(DRAFT)
  activityState      NBAActivityState    @default(ACTIVE)
  confidenceScore    Float      @default(50)
  status             NBAStatus  @default(PENDING) // Legacy
  userAnnotation     String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @default(now()) @updatedAt
  scheduledDate      DateTime?
  createdBy          String?
  sourceFlashcardIds String[]   @default([])
  publicId           Int?       @unique
  appVersion         String?    @default("0.8.0")
  brainVersion       String?    @default("local-brain@0.8.0")
  generatedAt        DateTime?
  hashtags           String[]   @default([])
  hashtagMaintainedAt DateTime?
  hashtagEvaluationPending Boolean @default(true)
  lastHashtagError   String?
  promptVersion      String?    @default("nba-policy@1.4.0")
  promptHash         String?
  promptName         String?    @default("nba-generation")
  modelName          String?    @default("granite-3.1-8b")
  modelVersion       String?
  temperature        Float?     @default(0.7)
  createdByRunId     String?
  cycleRunId         String?
  feedback           Feedback[]
  fingerprint        String?
  kind               String?    @default("TASK")
  company            Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Trinity Lifecycle State Machine (M1.2)
  candidateState     CandidateState @default(GENERATED)
  reworkRoute        ReworkRoute?
  // Trinity Scoring dimensions (M2.3)
  qualityScore       Float?     // absolute quality 0-1
  urgencyScore       Float?     // time-sensitivity 0-1
  freshnessScore     Float?     // evidence freshness 0-1
  feedbackScore      Float?     @default(0) // cumulative feedback signal
  evaluationReason   String?    // Evaluator's stated reason for disposition
  rottenAt           DateTime?  // when this candidate becomes stale and needs rework
  // Trinity Lineage (M1.3)
  versionFamilyId    String?    // groups all versions of the same conceptual candidate
  duplicateClusterId String?    // links semantic duplicate siblings
  generatedFromIds   String[]   @default([]) // source evidence IDs
  refinedFromId      String?    // the generated candidate this was refined from

  @@unique([companyId, fingerprint])
  @@index([companyId, processingStatus, cycleRunId])
  @@index([companyId, candidateState, iceScore])
  @@index([companyId, duplicateClusterId])
  @@index([companyId, versionFamilyId])
}

model HashtagFeedback {
  id         String                @id @default(uuid()) @map("_id")
  companyId  String
  entityType HashtagEntityType
  entityId   String
  tag        String
  action     HashtagFeedbackAction
  note       String?
  createdBy  String?               @default("webapp-user")
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @default(now()) @updatedAt
  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, entityType, entityId, createdAt])
  @@index([companyId, tag, createdAt])
}

model HashtagMaintenanceEvent {
  id         String                @id @default(uuid()) @map("_id")
  companyId  String
  entityType HashtagEntityType
  entityId   String
  status     HashtagMaintenanceStatus
  note       String?
  createdBy  String?               @default("local-ai")
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @default(now()) @updatedAt
  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, entityType, entityId, createdAt])
}


model Source {
  id              String   @id @default(uuid()) @map("_id")
  companyId       String
  publicId        Int?     @unique
  content         String
  canonicalContent String?
  canonicalContentHash String?
  canonicalizerVersion String?   @default("v1.4.0")
  hashtags        String[] @default([])
  hashtagMaintainedAt DateTime?
  hashtagEvaluationPending Boolean @default(true)
  lastHashtagError String?
  entityTag       String?
  aiClusters      String[] @default([])
  metadata        Json?
  legacyOriginKey String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  // Trinity Evidence Model fields (M1.1)
  sourceType      String?  @default("WEB") // WEB | UPLOAD | BRIDGE | MANUAL
  provenance      String?  // origin URL or reference
  topicHints      String[] @default([]) // topic label hints for Generator
  freshnessWindowDays Int? @default(30) // how many days this evidence is considered fresh
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, publicId, createdAt])
  @@index([companyId, legacyOriginKey])
  @@index([companyId, canonicalContentHash])
}

model Topic {
  id        String   @id @default(uuid()) @map("_id")
  companyId String
  label     String
  hashtags  String[] @default([])
  hashtagMaintainedAt DateTime?
  hashtagEvaluationPending Boolean @default(true)
  lastHashtagError String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, active, sortOrder])
  @@unique([companyId, label])
}

model PublicIdCounter {
  scope     String   @id @map("_id")
  value     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt
}

model GlobalSetting {
  id        String   @id @default(uuid()) @map("_id")
  key       String   @unique
  value     Json
  updatedAt DateTime @default(now()) @updatedAt
}

model WorkerReport {
  id        String   @id @default(uuid()) @map("_id")
  type      String
  data      Json
  createdAt DateTime @default(now())
}

model CommunicationSettings {
  id               String      @id @default(uuid()) @map("_id")
  companyId        String      @unique
  channel          ChannelType @default(IMESSAGE)
  handle           String?
  isEnabled        Boolean     @default(false)
  bridgeSecretHash String?     // v1.4.0: Hashed at rest
  minIceScore      Int         @default(600)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @default(now()) @updatedAt
  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model CreativeDraft {
  id            String             @id @default(uuid()) @map("_id")
  publicId      Int?               @unique
  companyId     String
  nbaItemId     String?
  type          CreativeDraftType  @default(EMAIL)
  status        CreativeDraftStatus @default(DRAFT)
  title         String
  subject       String?
  content       String
  iceScore      Float              @default(0)
  usageMetrics  Json?
  appVersion    String?            @default("0.10.0")
  brainVersion  String?            @default("worker-v4-alerting")
  promptVersion String?            @default("agency-policy@0.10.0")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt
  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status, createdAt])
}

enum CreativeDraftType {
  EMAIL
  LINKEDIN
  SMS
  AD_COPY
  CRM_NOTE
}

enum CreativeDraftStatus {
  DRAFT
  APPROVED
  SENT
  ARCHIVED
}

enum ChannelType {
  IMESSAGE
  WHATSAPP
  EMAIL
  WEBHOOK
}

model UploadedSourceFile {
  id        String   @id @default(uuid()) @map("_id")
  publicId  Int?     @unique
  companyId String
  name      String
  hashtags  String[] @default([])
  hashtagMaintainedAt DateTime?
  hashtagEvaluationPending Boolean @default(true)
  lastHashtagError String?
  entityTag String?
  mimeType  String
  sizeBytes Int
  content   Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model User {
  id             String   @id @default(uuid()) @map("_id")
  email          String
  name           String?
  companyId      String
  role           Role     @default(MEMBER)
  invitedAt      DateTime?
  invitedByEmail String?
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  company        Company  @relation(fields: [companyId], references: [id])


  @@unique([email, companyId])
}

enum ActionType {
  ACCEPT
  DECLINE
  MODIFY_ACCEPT
}

enum FlashcardActionType {
  ACCEPT
  DECLINE
  REJECT
  ANNOTATE
  MODIFY_ACCEPT
}

enum FlashcardCorrectionType {
  HIDE
  MARK_WRONG
  PIN
  REQUEST_REFRESH
  SUPPRESS_SOURCE
}

enum HashtagEntityType {
  SOURCE
  FILE
  FLASHCARD
  CHECKLIST
  TOPIC
}

enum HashtagMaintenanceStatus {
  SUCCESS
  FAILED
  SKIPPED
}

enum HashtagFeedbackAction {
  USER_REMOVE
  USER_ADD
  AI_ADD
  AI_REJECT
  AI_ACCEPT
}

enum FlashcardKind {
  SUMMARY
  EXPLANATION
  COMPARISON
  NEWS
  CONCLUSION
  EVALUATION
  OPINION
  JUDGMENT
  RECOMMENDATION
  RESEARCH
  FORECAST
  STOCK
  GOSSIP
  PRICE
}

enum FlashcardReviewStatus {
  PENDING
  ACCEPTED
  DECLINED
  MODIFIED_ACCEPTED
}

enum FlashcardSourceRole {
  PRIMARY
  SUPPORTING
  MERGED_FROM
}

enum FlashcardSourceType {
  SOURCE
  AGENT_FOUND
  FILE
}

enum FlashcardStatus {
  DRAFT
  CHECKED
  VERIFIED
  EXPIRED
  ACTIVE
  STALE
  ARCHIVED
}

enum GoalType {
  GROW_REVENUE
  LAUNCH_PRODUCT
  ENTER_NEW_MARKET
  BUILD_AWARENESS
  GENERATE_LEADS
}

enum NBAStatus {
  DRAFT
  CHECKED
  VERIFIED
  EXPIRED
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
  ARCHIVED
}

enum FlashcardProcessingStatus {
  DRAFT
  CHECKED
  VERIFIED
  ACCEPTED
  DECLINED
  REVIEW
}

enum FlashcardActivityState {
  ACTIVE
  STALE
  EXPIRED
  ARCHIVED
}

enum NBAProcessingStatus {
  DRAFT
  CHECKED
  VERIFIED
  ACCEPTED
  DECLINED
  REVIEW
}

enum NBAActivityState {
  ACTIVE
  STALE
  EXPIRED
  ARCHIVED
}

// Trinity Formal Lifecycle State Machine (M1.2)
enum CandidateState {
  GENERATED   // Output of Generator stage
  REFINED     // Output of Refiner stage
  EVALUATED   // Output of Evaluator stage — eligible for frontier
  REWORK      // Returned to pipeline for another pass
  SUPPRESSED  // Dominated by sibling — excluded from frontier
  DELIVERED   // Action confirmed executed in reality (stronger than ACCEPTED)
  ARCHIVED    // Permanently removed from active pool
}

// Trinity Rework Routes (M1.2)
enum ReworkRoute {
  REVISE          // Rewrite for clarity or precision
  REGENERATE      // Full regeneration from evidence
  MERGE           // Combine with a sibling candidate
  ENRICH          // Add supporting context or grounding
  DOWNRANK_ONLY   // Keep in pool but lower frontier priority
}

enum Role {
  SUPERADMIN
  OWNER
  ADMIN
  MEMBER
}

model MemoryCanon {
  id               String   @id @default(uuid()) @map("_id")
  memoryEntryId    String   @unique
  companyId        String
  scope            String   // CARD | TOPIC | GLOBAL
  sourceSignalId   String?
  sourceSignalType String?
  entityId         String?
  content          String
  weightInitial    Float    @default(1.0)
  weightFinal      Float    @default(1.0)
  status           String   @default("ACTIVE") // ACTIVE | SUPERSEDED | PRUNED | CONFLICT
  supersededBy     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  expiresAt        DateTime?

  @@index([companyId, scope, weightFinal, createdAt])
}
